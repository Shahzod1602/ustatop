{
  "expo": {
    "name": "UstaTop",
    "slug": "ustatop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ustatop",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0ede8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.ustatop.app",
      "config": {
        "googleMapsApiKey": ""
      }
    },
    "android": {
      "package": "uz.ustatop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f0ede8"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-location"
    ]
  }
}
